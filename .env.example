APP_ENV=development
DATA_MODE=fixture
ACTION_MODE=simulation
DATABASE_URL=sqlite:///./kedaiflow.db
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
PRIVATE_MEDIA_DIR=./private_media
SESSION_HOURS=12
# Configure locally; never paste secrets into chat or commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling
APP_BASE_URL=
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional image-capable Groq model; blank keeps image extraction in manual review.
GROQ_VISION_MODEL=
MODEL_PROCESSING_APPROVED=false
# Optional server-side speech transcription. Keep real keys in .env only.
SPEECH_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Leave blank for automatic language detection / mixed-language recordings.
ELEVENLABS_LANGUAGE_CODE=
SPEECH_PROCESSING_APPROVED=false
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Local auth is development-only. Production requires Supabase JWT validation.
AUTH_MODE=local

# FLOW / BijakSense (independent of capture and transcription)
# Reuses private GROQ_API_KEY unless a separate key is supplied here in .env.
BIJAKSENSE_QWEN_MODEL=qwen/qwen3.8-27b
BIJAKSENSE_QWEN_API_KEY=
# Commercial Open-Meteo key; blank uses the non-commercial evaluation endpoint.
BIJAKSENSE_OPEN_METEO_API_KEY=
# Optional authorized public RSS source override. Blank uses news discovery RSS.
BIJAKSENSE_NEWS_RSS_URL=
BIJAKSENSE_EMBEDDINGS_ENABLED=true
BIJAKSENSE_SCHEDULE_ENABLED=true
BIJAKSENSE_REFRESH_HOURS=6
# Optional replacement when World Bank publishes a new workbook URL.
BIJAKSENSE_WORLD_BANK_URL=https://thedocs.worldbank.org/en/doc/74e8be41ceb20fa0da750cda2f6b9e4e-0050012026/related/CMO-Historical-Data-Monthly.xlsx
